# ============================================================
#  bot-whatsapp-2 — Variables de entorno (REFERENCIA)
#  Bot de WhatsApp conectado por CÓDIGO QR (Baileys), SIN API de Meta.
#  Número del bot: +57 322 666 2517
# ============================================================
#  En local, copia este archivo como ".env" y rellena los valores.
#  El archivo ".env" NO se sube a GitHub (ya está en .gitignore).
# ============================================================

PORT=10000

# --- Conexión por QR (Baileys) ---
# Nombre que verá WhatsApp como dispositivo vinculado.
BOT_NAME=Bot Tramites
# Carpeta donde se guarda la sesión (el QR se escanea una sola vez).
# Por defecto: ./auth_baileys
AUTH_DIR=

# --- Vinculación por CÓDIGO (opcional, más confiable que el QR) ---
# Número del bot CON código de país, sin "+" ni ceros iniciales.
# Permite vincular desde WhatsApp → Ajustes → Dispositivos vinculados →
# "Vincular con el número del teléfono" (se muestra en /pair).
PAIRING_PHONE=

# --- Administrador ---
# Número del dueño/administrador (opcional). Sirve SOLO para que el dueño
# pueda enviar comandos al bot (ej: "clientes", "estado"). Déjalo vacío si no
# quieres canal de comandos.
ADMIN_PHONE=
# Avisos automáticos al administrador (copia de cada aviso al admin).
# Por defecto DESACTIVADO: como el bot responde desde el mismo número donde
# llega toda la información, no hace falta reenviar copias.
ADMIN_NOTIFICATIONS_ENABLED=false

# --- IA (Groq) ---
# Clave de Groq (para responder preguntas abiertas y transcribir audios).
GROQ_API_KEY=
# Modelo de Groq (opcional; por defecto openai/gpt-oss-120b).
GROQ_MODEL=

# --- Consulta de cédula ---
# API oficial (recomendado): devuelve fecha de nacimiento + datos electorales.
# Si se dejan vacías, el bot usa un respaldo web gratuito (datos parciales).
CEDULA_APP_ID=
CEDULA_TOKEN=

# --- Respaldo durable de sesiones en Supabase (opcional) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Keep-alive (opcional) ---
# URL pública del servicio. Si se define, el bot hace ping a su propio /health
# cada 5 minutos para reducir que el host gratuito "duerma".
# En Render se toma automáticamente de RENDER_EXTERNAL_URL.
SELF_URL=
